<UserControl x:Class="Arclight.Desktop.Views.RecentlyPlayedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Arclight.Desktop.Controls"
             xmlns:vm="clr-namespace:Arclight.Desktop.ViewModels">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460" Margin="0,0,0,80"
                    Visibility="{Binding IsEmpty, Converter={StaticResource VisibleWhen}}">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE81C;" FontSize="40" Foreground="{DynamicResource Brush.Accent.Text}" />
            <TextBlock Text="{DynamicResource Recent.NothingPlayedYet}" Style="{StaticResource Text.Section}" TextAlignment="Center" Margin="0,16,0,0" />
            <TextBlock Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.Text.Secondary}" TextAlignment="Center" Margin="0,8,0,0"
                       Text="{DynamicResource Recent.LaunchAGameFromArclight}" />
            <Button Style="{StaticResource Button.Primary}" Content="{DynamicResource Recent.GoToMyLibrary}" Command="{Binding OpenLibraryCommand}" HorizontalAlignment="Center" Padding="18,10" Margin="0,22,0,0" />
        </StackPanel>

        <Grid Visibility="{Binding IsEmpty, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.ColumnSpan="2" Margin="36,8,36,20">
                <TextBlock Text="{DynamicResource Common.RecentlyPlayed}" Style="{StaticResource Text.Title}" />
                <TextBlock Text="{DynamicResource Recent.YourLatestGamesAndEvery}" Style="{StaticResource Text.Secondary}" Margin="0,3,0,0" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Games}" Margin="36,0,18,40">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:GameItemViewModel}">
                            <Border x:Name="Row" Background="{DynamicResource Brush.Bg.Card}" CornerRadius="14" Margin="0,0,0,12" Padding="12" Cursor="Hand"
                                    BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1"
                                    ContextMenu="{StaticResource ContextMenu.Game}" controls:Ui.ClickCommand="{Binding DetailsCommand}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="168" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <controls:GameArt Height="94" ImagePath="{Binding WideArtPath}" IconPath="{Binding IconPath}" Title="{Binding Name}"
                                                      ShowTitle="False" DecodeWidth="336" CornerRadius="10" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="18,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Subtitle}" FontSize="16" />
                                            <Border Background="{DynamicResource Brush.Success.Soft}" CornerRadius="999" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center"
                                                    Visibility="{Binding IsRunning, Converter={StaticResource VisibleWhen}}">
                                                <TextBlock Text="{DynamicResource Common.PlayingNow}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Success}" />
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Template.PlatformBadge}" />
                                            <TextBlock Text="{Binding LastPlayedText}" Style="{StaticResource Text.Secondary}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE916;" FontSize="13" Foreground="{DynamicResource Brush.Text.Muted}" />
                                            <TextBlock Text="{Binding PlaytimeLong}" Style="{StaticResource Text.Secondary}" Margin="7,0,18,0" />
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE823;" FontSize="13" Foreground="{DynamicResource Brush.Text.Muted}" />
                                            <TextBlock Text="{Binding SessionsText}" Style="{StaticResource Text.Secondary}" Margin="7,0,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource Button.Primary}" Command="{Binding PlayCommand}" Content="{Binding PrimaryActionText}"
                                            VerticalAlignment="Center" Padding="18,9" Margin="0,0,6,0" MinWidth="96" />
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,36,40" Padding="0" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Recent.SessionHistory}" Style="{StaticResource Text.Subtitle}" Margin="20,18,20,4" />
                    <TextBlock Text="{DynamicResource Recent.OnlyVerifiedTimeIsListed}" Style="{StaticResource Text.Caption}" Margin="20,0,20,12" />
                    <TextBlock Text="{DynamicResource Recent.NoCompletedSessionsYet}" Style="{StaticResource Text.Secondary}" Margin="20,4,20,20"
                               Visibility="{Binding HasSessions, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                    <ItemsControl ItemsSource="{Binding Sessions}" Margin="8,0,8,10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SessionRow}">
                                <Grid Margin="12,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" CornerRadius="9" Background="#12FFFFFF" Margin="0,0,12,0" ToolTip="{Binding SourceText}">
                                        <TextBlock Style="{StaticResource Icon}" Text="{Binding SourceGlyph}" FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding GameName}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource Text.Caption}">
                                            <Run Text="{Binding DateText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding TimeText, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontSize="13" Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
