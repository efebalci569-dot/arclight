<UserControl x:Class="Arclight.Desktop.Views.GameDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Arclight.Desktop.Controls"
             xmlns:vm="clr-namespace:Arclight.Desktop.ViewModels"
             xmlns:models="clr-namespace:Arclight.Core.Models;assembly=Arclight.Core">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasItem, Converter={StaticResource VisibleWhen}}">
        <StackPanel Margin="0,0,0,40">
            <!-- ============================================================ Hero -->
            <Grid Height="400" Margin="20,0,20,0">
                <controls:ClipBorder CornerRadius="20" Background="{DynamicResource Brush.Bg.Card}">
                    <Grid>
                        <controls:GameArt ImagePath="{Binding Item.WideArtPath}" IconPath="{Binding Item.IconPath}" Title="{Binding Item.Name}" ShowTitle="False"
                                          DecodeWidth="1800" CornerRadius="0" />
                        <Border Background="{DynamicResource Brush.Scrim.Left}" />
                        <Border Background="{DynamicResource Brush.Scrim.Bottom}" />
                    </Grid>
                </controls:ClipBorder>
                <Border CornerRadius="20" BorderThickness="1" BorderBrush="{DynamicResource Brush.Border.Subtle}" IsHitTestVisible="False" />

                <Button Style="{StaticResource Button.Secondary}" Command="{Binding BackCommand}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="22"
                        Padding="12,7" FontSize="13" Background="#73000000">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72B;" FontSize="12" Margin="0,0,8,0" />
                        <TextBlock Text="{DynamicResource Detail.Back}" />
                    </StackPanel>
                </Button>

                <Grid VerticalAlignment="Bottom" Margin="32,0,32,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="150" Height="200" Margin="0,0,28,0" VerticalAlignment="Bottom">
                        <Border CornerRadius="12" Background="#000000" Effect="{StaticResource Shadow.Card}" />
                        <controls:GameArt ImagePath="{Binding Item.CoverPath}" IconPath="{Binding Item.IconPath}" Title="{Binding Item.Name}" DecodeWidth="300" CornerRadius="12" TitleSize="13" />
                        <Border CornerRadius="12" BorderThickness="1" BorderBrush="#26FFFFFF" />
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                        <StackPanel Orientation="Horizontal">
                            <ContentPresenter Content="{Binding Item}" ContentTemplate="{StaticResource Template.PlatformBadge}" />
                            <Border CornerRadius="5" Padding="7,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource Brush.Success.Soft}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Item.IsInstalled}" Value="False">
                                                <Setter Property="Background" Value="#1AFFFFFF" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Item.InstallStatus}" FontSize="10.5" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Item.IsInstalled}" Value="False">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                            <Border Background="{DynamicResource Brush.Success.Soft}" CornerRadius="5" Padding="7,2" Margin="8,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding Item.IsRunning, Converter={StaticResource VisibleWhen}}">
                                <TextBlock Text="{DynamicResource Detail.PLAYINGNOW}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Success}" />
                            </Border>
                            <TextBlock Text="{Binding Item.Genre}" Foreground="#CCFFFFFF" FontSize="13" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding Item.Name}" Style="{StaticResource Text.Display}" FontSize="42" Foreground="White" Margin="0,10,0,0" TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis" MaxHeight="110" />
                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                            <Button Style="{StaticResource Button.Primary}" Command="{Binding Item.PlayCommand}" Padding="26,12" Margin="0,0,10,0" FontSize="15">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M 0,0 L 10,6 L 0,12 Z" Fill="White" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Item.PrimaryActionText}" />
                                </StackPanel>
                            </Button>
                            <ToggleButton Width="44" Height="44" Command="{Binding Item.ToggleFavoriteCommand}"
                                          IsChecked="{Binding Item.IsFavorite, Mode=OneWay}" Margin="0,0,8,0"
                                          ToolTip="{DynamicResource Common.Favorite}">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton" BasedOn="{StaticResource ToggleButton.Icon}">
                                        <Setter Property="Content" Value="&#xEB51;" />
                                        <Setter Property="Background" Value="#40000000" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Style.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter Property="Content" Value="&#xEB52;" />
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                                <Setter Property="Background" Value="{DynamicResource Brush.Danger.Soft}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <Button Style="{StaticResource Button.Icon}" Width="44" Height="44" Content="&#xE70F;" Command="{Binding Item.EditCommand}"
                                    Background="#40000000" Foreground="White" Margin="0,0,8,0" ToolTip="{DynamicResource Detail.Edit}" />
                            <Button x:Name="MoreButton" Style="{StaticResource Button.Icon}" Width="44" Height="44" Content="&#xE712;" Background="#40000000"
                                    Foreground="White" ToolTip="{DynamicResource Detail.More}" Click="OnMoreClick" DataContext="{Binding Item}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ============================================================ Stats -->
            <UniformGrid Columns="4" Margin="20,20,6,0">
                <Border Style="{StaticResource Card}" Margin="0,0,14,0" Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Detail.TotalPlaytime}" Style="{StaticResource Text.Secondary}" />
                        <TextBlock Text="{Binding Item.PlaytimeLong}" Style="{StaticResource Text.Metric}" FontSize="22" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,14,0" Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Detail.LastPlayed}" Style="{StaticResource Text.Secondary}" />
                        <TextBlock Text="{Binding Item.LastPlayedText}" Style="{StaticResource Text.Metric}" FontSize="22" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,14,0" Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Detail.Sessions}" Style="{StaticResource Text.Secondary}" />
                        <TextBlock Text="{Binding Item.SessionCount}" Style="{StaticResource Text.Metric}" FontSize="22" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,14,0" Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Detail.YourRating}" Style="{StaticResource Text.Secondary}" />
                        <controls:RatingControl Value="{Binding Rating, Mode=TwoWay}" StarSize="22" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ============================================================ Body -->
            <Grid Margin="20,20,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <!-- Notes -->
                    <Border Style="{StaticResource Card}" Padding="20">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="{DynamicResource Detail.PersonalNotes}" Style="{StaticResource Text.Subtitle}" />
                                <TextBlock Text="{Binding NotesStatus}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <TextBox Style="{StaticResource TextBox.Multiline}" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" MinHeight="170" MaxHeight="420"
                                     Margin="0,12,0,0" Tag="{DynamicResource Detail.WhereYouLeftOffQuests}" />
                        </StackPanel>
                    </Border>

                    <!-- Sessions -->
                    <Border Style="{StaticResource Card}" Padding="20" Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Detail.RecentSessions}" Style="{StaticResource Text.Subtitle}" />
                            <TextBlock Text="{Binding TrackingHint}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,4,0,8" />
                            <TextBlock Text="{DynamicResource Detail.NoSessionsRecordedYet}" Style="{StaticResource Text.Secondary}" Margin="0,6,0,0"
                                       Visibility="{Binding HasSessions, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                            <ItemsControl ItemsSource="{Binding Sessions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:SessionRow}">
                                        <Grid Margin="0,7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource Icon}" Text="{Binding SourceGlyph}" FontSize="12" Foreground="{DynamicResource Brush.Text.Muted}"
                                                       Margin="0,0,12,0" ToolTip="{Binding SourceText}" />
                                            <TextBlock Grid.Column="1" FontSize="13">
                                                <Run Text="{Binding DateText, Mode=OneWay}" /><Run Text="  ·  " Foreground="{DynamicResource Brush.Text.Muted}" /><Run Text="{Binding TimeText, Mode=OneWay}" Foreground="{DynamicResource Brush.Text.Secondary}" />
                                            </TextBlock>
                                            <TextBlock Grid.Column="2" Text="{Binding DurationText}" Style="{StaticResource Text.Secondary}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <!-- About -->
                    <Border Style="{StaticResource Card}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Common.About}" Style="{StaticResource Text.Subtitle}" />
                            <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="13"
                                       Margin="0,10,0,4" Visibility="{Binding HasDescription, Converter={StaticResource VisibleWhen}}" />
                            <ItemsControl ItemsSource="{Binding Info}" Margin="0,8,0,0" Grid.IsSharedSizeScope="True">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:InfoRow}">
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" MinWidth="110" SharedSizeGroup="InfoLabel" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Caption}" FontSize="12.5" Margin="0,0,14,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="13" TextWrapping="Wrap" ToolTip="{Binding Value}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Style="{StaticResource Button.Link}" Content="{DynamicResource Detail.EditDetails}" Command="{Binding Item.EditCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" FontSize="13" />
                        </StackPanel>
                    </Border>

                    <!-- Tags -->
                    <Border Style="{StaticResource Card}" Padding="20" Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Common.Tags}" Style="{StaticResource Text.Subtitle}" />
                            <TextBlock Text="{DynamicResource Detail.UseTagsLikeToFinish}" Style="{StaticResource Text.Caption}"
                                       TextWrapping="Wrap" TextTrimming="None" Margin="0,4,0,12" />
                            <controls:TagEditor Tags="{Binding Tags}" KnownTags="{Binding KnownTags}" />
                        </StackPanel>
                    </Border>

                    <!-- Collections -->
                    <Border Style="{StaticResource Card}" Padding="20" Margin="0,20,0,0">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="{DynamicResource Common.Collections}" Style="{StaticResource Text.Subtitle}" />
                                <Button Style="{StaticResource Button.Link}" Content="{DynamicResource Common.AddToCollection}" FontSize="13" HorizontalAlignment="Right" Click="OnAddToCollectionClick"
                                        DataContext="{Binding Item}" />
                            </Grid>
                            <TextBlock Text="{DynamicResource Detail.NotInAnyCollectionYet}" Style="{StaticResource Text.Secondary}" Margin="0,10,0,0"
                                       Visibility="{Binding HasCollections, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                            <ItemsControl ItemsSource="{Binding MemberOf}" Margin="0,10,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:GameCollection}">
                                        <Border Background="{DynamicResource Brush.Bg.Hover}" CornerRadius="999" Padding="12,5,6,5" Margin="0,0,6,6">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center" />
                                                <Button Style="{StaticResource Button.Icon}" Width="20" Height="20" FontSize="9" Content="&#xE711;" Margin="6,0,0,0"
                                                        controls:Ui.CornerRadius="10" ToolTip="{DynamicResource Detail.RemoveFromThisCollection}"
                                                        Command="{Binding DataContext.RemoveFromCollectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Tracking -->
                    <Border Style="{StaticResource Card}" Padding="20" Margin="0,20,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{DynamicResource Detail.BackgroundTracking}" Style="{StaticResource Text.Subtitle}" FontSize="14" />
                                <TextBlock Text="{DynamicResource Detail.LetTheOptionalBackgroundTracker}" Style="{StaticResource Text.Caption}"
                                           TextWrapping="Wrap" TextTrimming="None" Margin="0,4,0,0" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding TrackingEnabled}" IsEnabled="{Binding CanTrack}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
