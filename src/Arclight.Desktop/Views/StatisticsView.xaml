<UserControl x:Class="Arclight.Desktop.Views.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Arclight.Desktop.Controls"
             xmlns:vm="clr-namespace:Arclight.Desktop.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,8,36,40">
            <TextBlock Text="{DynamicResource Common.Statistics}" Style="{StaticResource Text.Title}" />
            <TextBlock Text="{DynamicResource Stats.CalculatedOnThisPCFrom}" Style="{StaticResource Text.Secondary}" Margin="0,3,0,22" />

            <!-- Why there is no data yet -->
            <Border Background="{DynamicResource Brush.Info.Soft}" BorderBrush="{DynamicResource Brush.Info}" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,0,22"
                    Visibility="{Binding HasTrackedTime, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" FontSize="16" Foreground="{DynamicResource Brush.Info}" VerticalAlignment="Top" Margin="0,2,14,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{DynamicResource Stats.NoPlaytimeTrackedYet}" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="13" Margin="0,4,0,0"
                                   Text="{DynamicResource Stats.ArclightCountsTimeOnlyWhile}" />
                    </StackPanel>
                </Grid>
            </Border>

            <ItemsControl ItemsSource="{Binding Tiles}" ItemTemplate="{StaticResource Template.StatTile}" Margin="0,0,-14,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- Last 30 days -->
            <Border Style="{StaticResource Card}" Margin="0,10,0,0" Padding="22,20">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="{DynamicResource Stats.Last30Days}" Style="{StaticResource Text.Subtitle}" />
                        <TextBlock Text="{Binding ActivitySummary}" Style="{StaticResource Text.Secondary}" HorizontalAlignment="Right" />
                    </Grid>
                    <controls:ActivityChart Points="{Binding Activity}" Height="230" Margin="0,14,0,0"
                                            BarBrush="{DynamicResource Brush.Accent}" HighlightBrush="{DynamicResource Brush.Info}" />
                </StackPanel>
            </Border>

            <Grid Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <!-- Most played -->
                <Border Style="{StaticResource Card}" Padding="22,20">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Stats.MostPlayed}" Style="{StaticResource Text.Subtitle}" />
                        <TextBlock Text="{DynamicResource Stats.GamesWithTrackedPlaytimeWill}" Style="{StaticResource Text.Secondary}" Margin="0,14,0,0"
                                   Visibility="{Binding TopGames.Count, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                        <ItemsControl ItemsSource="{Binding TopGames}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:TopGameRow}">
                                    <Grid Margin="0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30" />
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Rank}" Style="{StaticResource Text.Secondary}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <controls:GameArt Grid.Column="1" Width="30" Height="40" HorizontalAlignment="Left" ImagePath="{Binding Game.CoverPath}"
                                                          IconPath="{Binding Game.IconPath}" Title="{Binding Name}" ShowTitle="False" DecodeWidth="60" CornerRadius="5" />
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <Grid>
                                                <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,80,0" />
                                                <TextBlock Text="{Binding Hours}" Style="{StaticResource Text.Secondary}" HorizontalAlignment="Right" />
                                            </Grid>
                                            <Grid Height="6" Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding FilledWidth}" />
                                                    <ColumnDefinition Width="{Binding EmptyWidth}" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.ColumnSpan="2" CornerRadius="3" Background="#14FFFFFF" />
                                                <Border CornerRadius="3" Background="{DynamicResource Brush.Arc}" />
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Platforms -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="22,20">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Stats.GamesByPlatform}" Style="{StaticResource Text.Subtitle}" />
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <controls:DonutChart Width="170" Height="170" Segments="{Binding PlatformSegments}" CenterText="{Binding PlatformTotal}" CenterCaption="{DynamicResource Stats.DonutCaption}" />
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding PlatformLegend}" Margin="20,0,0,0" VerticalAlignment="Center">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:LegendRow}">
                                        <Grid Margin="0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="9" Height="9" Fill="{Binding Brush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="{Binding Value}" Style="{StaticResource Text.Caption}" FontSize="12.5" Margin="10,0,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
