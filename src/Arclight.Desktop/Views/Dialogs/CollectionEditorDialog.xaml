<UserControl x:Class="Arclight.Desktop.Views.Dialogs.CollectionEditorDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Arclight.Desktop.Controls">
    <StackPanel Margin="28,26,28,24">
        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Section}" FontSize="20" />
        <TextBlock Text="{DynamicResource CollectionEditor.Name}" Style="{StaticResource Text.Secondary}" Margin="0,20,0,6" />
        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Tag="{DynamicResource CollectionEditor.EGWeekendGames}" MaxLength="60" x:Name="NameBox" />
        <TextBlock Text="{DynamicResource CollectionEditor.DescriptionOptional}" Style="{StaticResource Text.Secondary}" Margin="0,16,0,6" />
        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Tag="{DynamicResource CollectionEditor.WhatBelongsHere}" MaxLength="200" />
        <TextBlock Text="{DynamicResource CollectionEditor.CoverOptional}" Style="{StaticResource Text.Secondary}" Margin="0,16,0,6" />
        <StackPanel Orientation="Horizontal">
            <controls:GameArt Width="120" Height="70" CornerRadius="10" ImagePath="{Binding CoverImagePath}" Title="{Binding Name}" ShowTitle="False" DecodeWidth="240" />
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <Button Style="{StaticResource Button.Secondary}" Content="{DynamicResource CollectionEditor.ChooseImage}" Command="{Binding PickCoverCommand}" Padding="12,6" FontSize="13" HorizontalAlignment="Left" />
                <Button Style="{StaticResource Button.Link}" Content="{DynamicResource CollectionEditor.UseGameCoversInstead}" Command="{Binding ClearCoverCommand}" FontSize="12.5" Margin="0,8,0,0" HorizontalAlignment="Left"
                        Visibility="{Binding HasCover, Converter={StaticResource VisibleWhen}}" />
            </StackPanel>
        </StackPanel>
        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Brush.Danger}" FontSize="13" Margin="0,14,0,0" TextWrapping="Wrap"
                   Visibility="{Binding HasError, Converter={StaticResource VisibleWhen}}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Style="{StaticResource Button.Ghost}" Content="{DynamicResource Common.Cancel}" Command="{Binding CancelCommand}" Padding="16,9" Margin="0,0,8,0" />
            <Button Style="{StaticResource Button.Primary}" Content="{Binding SaveText}" Command="{Binding SaveCommand}" Padding="18,9" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</UserControl>
