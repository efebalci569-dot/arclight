<UserControl x:Class="Arclight.Desktop.Views.Dialogs.ConfirmDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="28,26,28,24">
        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Section}" FontSize="19" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,12,0,0" />
        <CheckBox Content="{Binding OptionText}" IsChecked="{Binding OptionChecked}" Margin="0,18,0,0" FontSize="13.5"
                  Visibility="{Binding HasOption, Converter={StaticResource VisibleWhen}}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,26,0,0">
            <Button Style="{StaticResource Button.Ghost}" Content="{Binding CancelText}" Command="{Binding CancelCommand}" Padding="16,9" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" Padding="18,9" IsDefault="True">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource Button.Primary}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDanger}" Value="True">
                                <Setter Property="Background" Value="#E5484D" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </StackPanel>
</UserControl>
