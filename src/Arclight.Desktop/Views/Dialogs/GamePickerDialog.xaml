<UserControl x:Class="Arclight.Desktop.Views.Dialogs.GamePickerDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Arclight.Desktop.Controls"
             xmlns:dialogs="clr-namespace:Arclight.Desktop.ViewModels.Dialogs"
             Height="560">
    <Grid Margin="0,0,0,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Section}" FontSize="20" Margin="26,24,26,14" />
        <TextBox Grid.Row="1" Style="{StaticResource TextBox.Search}" Tag="{DynamicResource Picker.SearchYourLibrary}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="26,0,26,10" Height="40" />
        <TextBlock Grid.Row="2" Text="{DynamicResource Picker.ThereAreNoGamesTo}" Style="{StaticResource Text.Secondary}" Margin="26,16"
                   Visibility="{Binding IsEmpty, Converter={StaticResource VisibleWhen}}" />
        <ListBox Grid.Row="2" ItemsSource="{Binding Visible}" Style="{StaticResource ListBox.Plain}" Margin="16,0" VirtualizingPanel.IsVirtualizing="True">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type dialogs:PickableGame}">
                    <Grid Background="Transparent" Cursor="Hand"
                          controls:Ui.ClickCommand="{Binding DataContext.PickCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          controls:Ui.ClickCommandParameter="{Binding}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{Binding IsSelected}" Margin="0,0,12,0" IsHitTestVisible="False"
                                  Visibility="{Binding DataContext.IsMultiSelect, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource VisibleWhen}}" />
                        <controls:GameArt Grid.Column="1" Width="30" Height="40" ImagePath="{Binding Item.CoverPath}" IconPath="{Binding Item.IconPath}" Title="{Binding Item.Name}"
                                          ShowTitle="False" DecodeWidth="60" CornerRadius="5" />
                        <StackPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Item.Name}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Item.PlatformName}" Style="{StaticResource Text.Caption}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="26,14,26,0">
            <Button Style="{StaticResource Button.Ghost}" Content="{DynamicResource Common.Cancel}" Command="{Binding CancelCommand}" Padding="16,9" Margin="0,0,8,0" />
            <Button Style="{StaticResource Button.Primary}" Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" Padding="18,9"
                    Visibility="{Binding IsMultiSelect, Converter={StaticResource VisibleWhen}}" />
        </StackPanel>
    </Grid>
</UserControl>
