<UserControl x:Class="Arclight.Desktop.Views.Dialogs.InfoDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="28,24,28,6">
            <Image Source="/Resources/Brand/arclight-mark-128.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Section}" FontSize="20" Margin="12,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Items}" Margin="28,10,28,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,18">
                            <TextBlock Text="{Binding Heading}" Style="{StaticResource Text.Subtitle}" />
                            <TextBlock Text="{Binding Body}" Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,6,0,0" FontSize="13.5" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="28,8,28,24">
            <Button Style="{StaticResource Button.Ghost}" Content="{DynamicResource Dialog.OpenGitHub}" Command="{Binding OpenRepositoryCommand}" Padding="16,9" Margin="0,0,8,0" />
            <Button Style="{StaticResource Button.Primary}" Content="{DynamicResource Dialog.GotIt}" Command="{Binding CloseCommand}" Padding="20,9" IsDefault="True" />
        </StackPanel>
    </Grid>
</UserControl>
