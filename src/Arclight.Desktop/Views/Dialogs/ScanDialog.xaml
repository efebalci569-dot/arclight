<UserControl x:Class="Arclight.Desktop.Views.Dialogs.ScanDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dialogs="clr-namespace:Arclight.Desktop.ViewModels.Dialogs"
             Height="640">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Header -->
        <Grid Grid.ColumnSpan="2" Margin="28,24,24,16">
            <StackPanel>
                <TextBlock Text="{DynamicResource Common.ScanForGames}" Style="{StaticResource Text.Section}" FontSize="20" />
                <TextBlock Text="{Binding HeaderText}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,0" />
            </StackPanel>
            <Button Style="{StaticResource Button.Secondary}" Command="{Binding RescanCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="14,7" FontSize="13">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="12" Margin="0,0,8,0" />
                    <TextBlock Text="{DynamicResource Scan.ScanAgain}" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Platforms -->
        <Border Grid.Row="1" Background="{DynamicResource Brush.Bg.Card}" CornerRadius="14" Margin="24,0,0,0" Padding="6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Scan.PLATFORMS}" Style="{StaticResource Text.Caption}" FontWeight="SemiBold" Margin="12,10,12,6" />
                <Border DockPanel.Dock="Bottom" Background="{DynamicResource Brush.Danger.Soft}" CornerRadius="10" Padding="10,8" Margin="6,6,6,6"
                        Visibility="{Binding HasErrors, Converter={StaticResource VisibleWhen}}">
                    <Expander Header="{DynamicResource Scan.SomeItemsWereSkipped}" Foreground="{DynamicResource Brush.Danger}" FontSize="12.5">
                        <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Errors}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="11.5" Foreground="{DynamicResource Brush.Text.Secondary}" TextWrapping="Wrap" Margin="0,2" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Expander>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding PlatformItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type dialogs:ScanPlatformItem}">
                                <Grid Margin="10,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ContentControl Style="{StaticResource Spinner}" VerticalAlignment="Top" Margin="0,2,0,0"
                                                    Visibility="{Binding IsRunning, Converter={StaticResource VisibleWhen}}" />
                                    <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="13" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,2,0,0"
                                               Foreground="{Binding StateBrushKey, Converter={StaticResource ResourceBrush}}"
                                               Visibility="{Binding IsRunning, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                                    <StackPanel Grid.Column="1">
                                        <WrapPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,8,0" />
                                            <Border Background="{DynamicResource Brush.Warning.Soft}" CornerRadius="5" Padding="6,0" Margin="0,1,0,0" VerticalAlignment="Center"
                                                    Visibility="{Binding HasSupportText, Converter={StaticResource VisibleWhen}}">
                                                <TextBlock Text="{Binding SupportText}" FontSize="10.5" Foreground="{DynamicResource Brush.Warning}" />
                                            </Border>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Results -->
        <Grid Grid.Row="1" Grid.Column="1" Margin="18,0,24,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource Chip}" IsChecked="{Binding IsNewTab}" GroupName="ScanTab">
                        <TextBlock><Run Text="{DynamicResource Scan.New}" /><Run Text="{Binding NewCount, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Chip}" IsChecked="{Binding IsInLibraryTab}" GroupName="ScanTab">
                        <TextBlock><Run Text="{DynamicResource Scan.InLibrary}" /><Run Text="{Binding InLibraryCount, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Chip}" IsChecked="{Binding IsHiddenTab}" GroupName="ScanTab">
                        <TextBlock><Run Text="{DynamicResource Scan.Hidden}" /><Run Text="{Binding HiddenCount, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                    </RadioButton>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Visibility="{Binding IsInLibraryTab, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
                    <Button Style="{StaticResource Button.Ghost}" Content="{DynamicResource Common.SelectAll}" Command="{Binding SelectAllCommand}" FontSize="12.5" Padding="10,5" />
                    <Button Style="{StaticResource Button.Ghost}" Content="{DynamicResource Scan.None}" Command="{Binding SelectNoneCommand}" FontSize="12.5" Padding="10,5" />
                </StackPanel>
            </Grid>

            <TextBlock Grid.Row="1" Text="{Binding EmptyText}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="4,20" MaxWidth="460" HorizontalAlignment="Left"
                       Visibility="{Binding IsCurrentTabEmpty, Converter={StaticResource VisibleWhen}}" />

            <ListBox Grid.Row="1" ItemsSource="{Binding CandidatesView}" Style="{StaticResource ListBox.Plain}" VirtualizingPanel.IsVirtualizing="True">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource ListItem.Plain}">
                        <Setter Property="Padding" Value="10,9" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type dialogs:ScanCandidateItem}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{Binding IsSelected}" Margin="0,0,14,0" VerticalAlignment="Center"
                                      Visibility="{Binding DataContext.IsInLibraryTab, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Location}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" ToolTip="{Binding Location}" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding HasNote, Converter={StaticResource VisibleWhen}}">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="11" Margin="0,0,6,0" Foreground="{DynamicResource Brush.Warning}"
                                               Visibility="{Binding IsWarning, Converter={StaticResource VisibleWhen}}" />
                                    <TextBlock Text="{Binding Note}" FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock Text="{Binding MatchText}" Style="{StaticResource Text.Caption}" Margin="0,3,0,0"
                                           Visibility="{Binding MatchReason, Converter={StaticResource VisibleWhen}}" />
                            </StackPanel>
                            <Border Grid.Column="2" Background="#1AFFFFFF" CornerRadius="5" Padding="7,2" VerticalAlignment="Top" Margin="10,2,0,0">
                                <TextBlock Text="{Binding PlatformName}" FontSize="11" Foreground="{DynamicResource Brush.Text.Secondary}" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Grid.ColumnSpan="2" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="28,14,24,18">
            <Grid>
                <TextBlock Style="{StaticResource Text.Caption}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,380,0"
                           Text="{DynamicResource Scan.OnlyLauncherRecordsAreRead}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource Button.Ghost}" Content="{DynamicResource Scan.HideSelected}" Command="{Binding HideSelectedCommand}" Padding="14,9" Margin="0,0,8,0"
                            ToolTip="{DynamicResource Scan.DontSuggestTheseAgain}" Visibility="{Binding IsNewTab, Converter={StaticResource VisibleWhen}}" />
                    <Button Style="{StaticResource Button.Secondary}" Content="{DynamicResource Scan.Done}" Command="{Binding DoneCommand}" Padding="16,9" Margin="0,0,8,0"
                            IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBool}}" />
                    <Button Style="{StaticResource Button.Primary}" Command="{Binding AddSelectedCommand}" Padding="18,9">
                        <TextBlock><Run Text="{DynamicResource Scan.AddSelected}" /><Run Text="{Binding SelectedCount, Mode=OneWay}" /><Run Text=")" /></TextBlock>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
