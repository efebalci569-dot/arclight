<UserControl x:Class="Arclight.Desktop.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Arclight.Desktop.Controls">
    <Grid>
        <!-- ============================================================ Empty state -->
        <Grid Visibility="{Binding HasGames, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560" Margin="40,0,40,60">
                <Grid Width="132" Height="132" HorizontalAlignment="Center">
                    <Ellipse Fill="{DynamicResource Brush.Accent}" Opacity="0.16" Width="132" Height="132">
                        <Ellipse.Effect>
                            <BlurEffect Radius="40" />
                        </Ellipse.Effect>
                    </Ellipse>
                    <Image Source="/Resources/Brand/arclight-mark-128.png" Width="84" Height="84" RenderOptions.BitmapScalingMode="HighQuality" />
                </Grid>
                <TextBlock Text="{DynamicResource Home.YourGameLibraryStartsHere}" Style="{StaticResource Text.Display}" FontSize="32" TextAlignment="Center" Margin="0,22,0,0"
                           TextWrapping="Wrap" />
                <TextBlock Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.Text.Secondary}" TextAlignment="Center" Margin="0,14,0,0"
                           Text="{DynamicResource Home.ArclightBringsYourSteamEpic}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,28,0,0">
                    <Button Style="{StaticResource Button.Primary}" Command="{Binding ScanCommand}" Padding="20,11" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE895;" FontSize="14" Foreground="White" Margin="0,0,9,0" />
                            <TextBlock Text="{DynamicResource Common.ScanForGames}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Button.Secondary}" Command="{Binding AddGameCommand}" Padding="20,11" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="13" Margin="0,0,9,0" />
                            <TextBlock Text="{DynamicResource Common.AddAGame}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Button.Ghost}" Command="{Binding LearnMoreCommand}" Content="{DynamicResource Home.LearnMore}" Padding="16,11" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ============================================================ Dashboard -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasGames, Converter={StaticResource VisibleWhen}}">
            <StackPanel Margin="36,8,30,40">
                <TextBlock Text="{Binding Greeting}" Style="{StaticResource Text.Title}" />
                <TextBlock Text="{DynamicResource Home.HeresYourGameUniverseToday}" Style="{StaticResource Text.Secondary}" FontSize="14" Margin="0,4,0,22" />

                <!-- New games banner -->
                <Border Background="{DynamicResource Brush.Accent.Soft}" BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="1" CornerRadius="12"
                        Padding="16,12" Margin="0,0,0,22" Visibility="{Binding HasNewGames, Converter={StaticResource VisibleWhen}}">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7FC;" FontSize="16" Foreground="{DynamicResource Brush.Accent.Text}" Margin="0,0,12,0" />
                            <TextBlock FontSize="14" VerticalAlignment="Center">
                                <Run Text="{Binding NewGamesDetected, Mode=OneWay}" FontWeight="SemiBold" />
                                <Run Text="{DynamicResource Home.NewGamesWereFoundOn}" />
                            </TextBlock>
                        </StackPanel>
                        <Button Style="{StaticResource Button.Primary}" Content="{DynamicResource Home.Review}" Command="{Binding ReviewNewGamesCommand}" HorizontalAlignment="Right" Padding="16,7" FontSize="13" />
                    </Grid>
                </Border>

                <!-- Featured -->
                <Grid Height="340">
                    <controls:ClipBorder CornerRadius="18" Background="{DynamicResource Brush.Bg.Card}">
                        <Grid>
                            <controls:GameArt ImagePath="{Binding Featured.WideArtPath}" IconPath="{Binding Featured.IconPath}" Title="{Binding Featured.Name}"
                                              ShowTitle="False" DecodeWidth="1600" CornerRadius="0"
                                              Visibility="{Binding HasFeatured, Converter={StaticResource VisibleWhen}}" />
                            <Border Background="{DynamicResource Brush.Scrim.Left}" />
                            <Border Background="{DynamicResource Brush.Scrim.Bottom}" Opacity="0.7" />
                            <!-- No featured game chosen yet -->
                            <Border Visibility="{Binding HasFeatured, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Offset="0" Color="#2A1B4D" />
                                        <GradientStop Offset="0.6" Color="#121220" />
                                        <GradientStop Offset="1" Color="#0B2233" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </controls:ClipBorder>
                    <Border CornerRadius="18" BorderThickness="1" BorderBrush="{DynamicResource Brush.Border.Subtle}" IsHitTestVisible="False" />

                    <StackPanel VerticalAlignment="Bottom" Margin="36,0,36,32" MaxWidth="620" HorizontalAlignment="Left"
                                Visibility="{Binding HasFeatured, Converter={StaticResource VisibleWhen}}">
                        <TextBlock Text="{DynamicResource Home.FEATURED}" Style="{StaticResource Text.Overline}" />
                        <TextBlock Text="{Binding Featured.Name}" Style="{StaticResource Text.Display}" FontSize="40" Margin="0,6,0,0" Foreground="White" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <ContentPresenter Content="{Binding Featured}" ContentTemplate="{StaticResource Template.PlatformBadge}" />
                            <TextBlock Text="{Binding Featured.PlaytimeLong}" Foreground="#E6FFFFFF" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center" />
                            <TextBlock Text="·" Foreground="#80FFFFFF" Margin="8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Featured.LastPlayedText}" Foreground="#E6FFFFFF" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                            <Button Style="{StaticResource Button.Primary}" Command="{Binding PlayFeaturedCommand}" Padding="24,11" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M 0,0 L 10,6 L 0,12 Z" Fill="White" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Featured.PrimaryActionText}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Button.Secondary}" Command="{Binding FeaturedDetailsCommand}" Content="{DynamicResource Home.ViewDetails}" Padding="20,11"
                                    Background="#26FFFFFF" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel VerticalAlignment="Center" Margin="40,0" HorizontalAlignment="Left" MaxWidth="520"
                                Visibility="{Binding HasFeatured, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
                        <TextBlock Text="{DynamicResource Home.FEATURED}" Style="{StaticResource Text.Overline}" />
                        <TextBlock Text="{DynamicResource Home.PutAFavoriteInThe}" Style="{StaticResource Text.Display}" FontSize="32" Margin="0,8,0,0" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,10,0,0"
                                   Text="{DynamicResource Home.PickTheGameYouWant}" />
                        <Button Style="{StaticResource Button.Primary}" Command="{Binding ChooseFeaturedCommand}" Content="{DynamicResource Home.ChooseAGame}" HorizontalAlignment="Left"
                                Padding="20,10" Margin="0,20,0,0" />
                    </StackPanel>

                    <Button Style="{StaticResource Button.Secondary}" Command="{Binding ChooseFeaturedCommand}" Content="{DynamicResource Home.Change}" FontSize="12.5" Padding="12,6"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="18" Background="#59000000"
                            Visibility="{Binding HasFeatured, Converter={StaticResource VisibleWhen}}" />
                </Grid>

                <!-- Quick stats -->
                <ItemsControl ItemsSource="{Binding Stats}" ItemTemplate="{StaticResource Template.StatTile}" Margin="0,24,-14,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- Continue playing -->
                <Grid Margin="0,22,0,14">
                    <TextBlock Text="{DynamicResource Home.ContinuePlaying}" Style="{StaticResource Text.Section}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Visibility="{Binding HasContinuePlaying, Converter={StaticResource VisibleWhen}}">
                        <Button Style="{StaticResource Button.Link}" Content="{DynamicResource Home.SeeAll}" Command="{Binding OpenRecentlyPlayedCommand}" Margin="0,0,14,0" VerticalAlignment="Center" />
                        <Button Style="{StaticResource Button.Icon}" Content="&#xE76B;" Width="32" Height="32" FontSize="11" Click="OnContinueLeft" ToolTip="{DynamicResource Home.ScrollLeft}" />
                        <Button Style="{StaticResource Button.Icon}" Content="&#xE76C;" Width="32" Height="32" FontSize="11" Click="OnContinueRight" ToolTip="{DynamicResource Home.ScrollRight}" />
                    </StackPanel>
                </Grid>
                <Border Style="{StaticResource Card}" Padding="20,18" Visibility="{Binding HasContinuePlaying, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="18" Foreground="{DynamicResource Brush.Accent.Text}" Margin="0,0,14,0" />
                        <TextBlock Style="{StaticResource Text.Secondary}" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Text="{DynamicResource Home.GamesYouPlayFromArclight}" />
                    </StackPanel>
                </Border>
                <ScrollViewer x:Name="ContinueScroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                              controls:Ui.ForwardVerticalWheel="True" Visibility="{Binding HasContinuePlaying, Converter={StaticResource VisibleWhen}}">
                    <ItemsControl ItemsSource="{Binding ContinuePlaying}" ItemTemplate="{StaticResource Template.WideCard}" Padding="0,6,0,4">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Recently added -->
                <Grid Margin="0,30,0,14">
                    <TextBlock Text="{DynamicResource Home.RecentlyAdded}" Style="{StaticResource Text.Section}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource Button.Link}" Content="{DynamicResource Home.OpenLibrary}" Command="{Binding OpenLibraryCommand}" Margin="0,0,14,0" VerticalAlignment="Center" />
                        <Button Style="{StaticResource Button.Icon}" Content="&#xE76B;" Width="32" Height="32" FontSize="11" Click="OnRecentLeft" ToolTip="{DynamicResource Home.ScrollLeft}" />
                        <Button Style="{StaticResource Button.Icon}" Content="&#xE76C;" Width="32" Height="32" FontSize="11" Click="OnRecentRight" ToolTip="{DynamicResource Home.ScrollRight}" />
                    </StackPanel>
                </Grid>
                <ScrollViewer x:Name="RecentScroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" controls:Ui.ForwardVerticalWheel="True">
                    <ItemsControl ItemsSource="{Binding RecentlyAdded}" ItemTemplate="{StaticResource Template.SmallCover}" Padding="0,4">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
