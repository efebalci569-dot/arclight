<Window x:Class="Arclight.Desktop.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Arclight.Desktop.Controls"
        xmlns:vm="clr-namespace:Arclight.Desktop.ViewModels"
        xmlns:services="clr-namespace:Arclight.Desktop.Services"
        Title="Arclight"
        Width="1380" Height="880" MinWidth="1040" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Bg.App}"
        Foreground="{DynamicResource Brush.Text.Primary}"
        FontFamily="{StaticResource Font.Text}" FontSize="14"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        Icon="/Resources/Brand/arclight.ico">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="64" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============================================================= Sidebar -->
        <Border Background="{DynamicResource Brush.Bg.Secondary}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="76" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="24,0,0,4" VerticalAlignment="Center">
                    <Image Source="/Resources/Brand/arclight-mark-128.png" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Arclight" FontFamily="{StaticResource Font.Display}" FontSize="20" FontWeight="SemiBold" Margin="11,0,0,1" VerticalAlignment="Center" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel Margin="12,4,12,12">
                        <TextBlock Text="{DynamicResource Shell.LIBRARY}" Style="{StaticResource Text.Caption}" FontSize="11" FontWeight="SemiBold" Margin="16,6,0,8" />
                        <RadioButton Style="{StaticResource NavItem}" Tag="&#xE80F;" Content="{DynamicResource Shell.Home}"
                                     IsChecked="{Binding SelectedNav, Converter={StaticResource EnumEquals}, ConverterParameter=Home}" />
                        <RadioButton Style="{StaticResource NavItem}" Tag="&#xE8F1;" Content="{DynamicResource Shell.MyLibrary}"
                                     IsChecked="{Binding SelectedNav, Converter={StaticResource EnumEquals}, ConverterParameter=Library}" />
                        <RadioButton Style="{StaticResource NavItem}" Tag="&#xE81E;" Content="{DynamicResource Common.Collections}"
                                     IsChecked="{Binding SelectedNav, Converter={StaticResource EnumEquals}, ConverterParameter=Collections}" />
                        <RadioButton Style="{StaticResource NavItem}" Tag="&#xE81C;" Content="{DynamicResource Common.RecentlyPlayed}"
                                     IsChecked="{Binding SelectedNav, Converter={StaticResource EnumEquals}, ConverterParameter=RecentlyPlayed}" />
                        <RadioButton Style="{StaticResource NavItem}" Tag="&#xEB51;" Content="{DynamicResource Common.Favorites}"
                                     IsChecked="{Binding SelectedNav, Converter={StaticResource EnumEquals}, ConverterParameter=Favorites}" />
                        <RadioButton Style="{StaticResource NavItem}" Tag="&#xE9D2;" Content="{DynamicResource Common.Statistics}"
                                     IsChecked="{Binding SelectedNav, Converter={StaticResource EnumEquals}, ConverterParameter=Statistics}" />
                        <RadioButton Style="{StaticResource NavItem}" Tag="&#xE909;" Content="{DynamicResource Shell.Discover}"
                                     IsChecked="{Binding SelectedNav, Converter={StaticResource EnumEquals}, ConverterParameter=Discover}" />
                        <Border Style="{StaticResource Divider}" Margin="12,12" />
                        <RadioButton Style="{StaticResource NavItem}" Tag="&#xE713;" Content="{DynamicResource Common.Settings}"
                                     IsChecked="{Binding SelectedNav, Converter={StaticResource EnumEquals}, ConverterParameter=Settings}" />
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Margin="14,0,14,16">
                    <Button Style="{StaticResource Button.Secondary}" Command="{Binding ScanCommand}" HorizontalAlignment="Stretch" Padding="12,10" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE895;" FontSize="14" Margin="0,0,9,0" />
                            <TextBlock Text="{DynamicResource Common.ScanForGames}" />
                        </StackPanel>
                    </Button>

                    <Border Background="{DynamicResource Brush.Bg.Card}" CornerRadius="12" Padding="12,11" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="10" Height="10" Margin="2,4,10,0" VerticalAlignment="Top">
                                <Grid.Resources>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource Brush.Text.Muted}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTrackingOn}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource Brush.Accent}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Resources>
                                <Ellipse Width="10" Height="10" Opacity="0.35" />
                                <Ellipse Width="6" Height="6" />
                            </Grid>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding StatusText}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding Version}" Style="{StaticResource Text.Caption}" FontSize="11" Margin="0,8,0,0" Opacity="0.8" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================= Main area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="20,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Style="{StaticResource Button.Icon}" Content="&#xE72B;" Command="{Binding GoBackCommand}" ToolTip="{DynamicResource Shell.BackAltLeft}"
                        Margin="0,0,10,0" WindowChrome.IsHitTestVisibleInChrome="True"
                        Visibility="{Binding CanGoBack, Converter={StaticResource VisibleWhen}}" />

                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="560" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox" Style="{StaticResource TextBox.Search}" Tag="{DynamicResource Shell.SearchGamesTagsCollectionsNotes}"
                             Text="{Binding Search.Text, UpdateSourceTrigger=PropertyChanged, Delay=120}"
                             Height="40" WindowChrome.IsHitTestVisibleInChrome="True" />
                </Grid>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,8,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,14,0" Visibility="{Binding IsScanning, Converter={StaticResource VisibleWhen}}">
                        <ContentControl Style="{StaticResource Spinner}" Margin="0,0,8,0" />
                        <TextBlock Text="{DynamicResource Shell.Scanning}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" />
                    </StackPanel>

                    <Button Style="{StaticResource Button.Primary}" Command="{Binding AddGameCommand}" Padding="14,8" FontSize="13"
                            WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="{DynamicResource Shell.AddAGameManuallyCtrl}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,8,0" Foreground="White" />
                            <TextBlock Text="{DynamicResource Shell.AddGame}" />
                        </StackPanel>
                    </Button>

                    <Grid Margin="8,0,0,0">
                        <ToggleButton x:Name="BellButton" Style="{StaticResource ToggleButton.Icon}" Content="&#xEA8F;" ToolTip="{DynamicResource Shell.Notifications}"
                                      IsChecked="{Binding IsNotificationsOpen, Mode=TwoWay}" WindowChrome.IsHitTestVisibleInChrome="True" />
                        <Border Background="{DynamicResource Brush.Accent}" CornerRadius="8" MinWidth="16" Height="16" Padding="4,0"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,0,0" IsHitTestVisible="False"
                                Visibility="{Binding Notifications.UnreadCount, Converter={StaticResource VisibleWhen}}">
                            <TextBlock Text="{Binding Notifications.UnreadCount, Converter={StaticResource Badge}}" FontSize="10" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>

                    <Button Command="{Binding OpenProfileCommand}" Margin="6,0,0,0" ToolTip="{DynamicResource Shell.ProfileAndSettings}"
                            Style="{StaticResource Button.Base}" Padding="0" Width="36" Height="36" controls:Ui.CornerRadius="18"
                            Background="{DynamicResource Brush.Arc}" WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock Text="{Binding ProfileInitial}" FontWeight="Bold" FontSize="14" Foreground="White" />
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="MinimizeButton" Style="{StaticResource Button.Caption}" Content="&#xE921;" Click="OnMinimize" ToolTip="{DynamicResource Shell.Minimize}" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource Button.Caption}" Content="&#xE922;" Click="OnMaximize" ToolTip="{DynamicResource Shell.Maximize}" />
                    <Button Style="{StaticResource Button.Caption.Close}" Content="&#xE8BB;" Click="OnClose" ToolTip="{DynamicResource Shell.Close}" />
                </StackPanel>
            </Grid>

            <ContentControl x:Name="PageHost" Grid.Row="1" Content="{Binding CurrentPage}" Focusable="False">
                <ContentControl.RenderTransform>
                    <TranslateTransform />
                </ContentControl.RenderTransform>
            </ContentControl>
        </Grid>

        <!-- ============================================================= Notification center -->
        <Popup PlacementTarget="{Binding ElementName=BellButton}" Placement="Bottom" HorizontalOffset="-300" VerticalOffset="6"
               IsOpen="{Binding IsNotificationsOpen, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Width="380" MaxHeight="520" Margin="10,0,10,16" Background="{DynamicResource Brush.Bg.Elevated}" CornerRadius="14"
                    BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1" Effect="{StaticResource Shadow.Popup}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="18,14,10,8">
                        <TextBlock Text="{DynamicResource Shell.Notifications}" Style="{StaticResource Text.Subtitle}" VerticalAlignment="Center" />
                        <Button Style="{StaticResource Button.Ghost}" Content="{DynamicResource Shell.ClearAll}" FontSize="12" Padding="10,5" HorizontalAlignment="Right"
                                Command="{Binding ClearNotificationsCommand}" />
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{DynamicResource Shell.YoureAllCaughtUp}" Style="{StaticResource Text.Secondary}" Margin="18,10,18,22"
                               Visibility="{Binding Notifications.History.Count, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Notifications.History}" Margin="8,0,8,10">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type services:NotificationEntry}">
                                    <Border Padding="10,9" CornerRadius="10" Background="Transparent">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="13" VerticalAlignment="Top" Margin="0,2,0,0"
                                                       Foreground="{DynamicResource Brush.Text.Secondary}" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" TextTrimming="None"
                                                           Margin="0,2,0,0" Visibility="{Binding Message, Converter={StaticResource VisibleWhen}}" />
                                                <TextBlock Text="{Binding TimeText}" Style="{StaticResource Text.Caption}" FontSize="11" Margin="0,4,0,0" Opacity="0.75" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Popup>

        <!-- ============================================================= Toasts -->
        <ItemsControl Grid.ColumnSpan="2" ItemsSource="{Binding Notifications.Toasts}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                      Margin="0,0,24,24" Width="380" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type services:Toast}">
                    <Border Background="{DynamicResource Brush.Bg.Elevated}" CornerRadius="14" Margin="0,10,0,0" Padding="0"
                            BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1" Effect="{StaticResource Shadow.Popup}">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="Slide" X="40" />
                        </Border.RenderTransform>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="40" To="0" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                        <Grid Margin="14,12,8,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" CornerRadius="9" VerticalAlignment="Top" Margin="0,1,12,0"
                                    Background="#14FFFFFF">
                                <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="14"
                                           Foreground="{Binding BrushKey, Converter={StaticResource ResourceBrush}}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Secondary}" FontSize="12.5" TextWrapping="Wrap" TextTrimming="None"
                                           Margin="0,3,0,0" Visibility="{Binding HasMessage, Converter={StaticResource VisibleWhen}}" />
                                <Button Style="{StaticResource Button.Secondary}" Content="{Binding ActionText}" Command="{Binding ActionCommand}"
                                        HorizontalAlignment="Left" Padding="12,6" FontSize="12.5" Margin="0,10,0,0"
                                        Visibility="{Binding HasAction, Converter={StaticResource VisibleWhen}}" />
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource Button.Icon}" Content="&#xE711;" FontSize="10" Width="28" Height="28"
                                    VerticalAlignment="Top" Command="{Binding DismissCommand}" ToolTip="{DynamicResource Shell.Dismiss}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ============================================================= Dialogs -->
        <ItemsControl Grid.ColumnSpan="2" ItemsSource="{Binding Dialogs.OpenDialogs}" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type services:DialogViewModel}">
                    <Grid>
                        <Border Background="{DynamicResource Brush.Bg.Overlay}" controls:Ui.ClickCommand="{Binding DismissCommand}" />
                        <Border Width="{Binding DialogWidth}" MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Multiply}, ConverterParameter=0.9}"
                                VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"
                                Background="{DynamicResource Brush.Bg.Elevated}" CornerRadius="18"
                                BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1" Effect="{StaticResource Shadow.Popup}">
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.16" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                            <ContentPresenter Content="{Binding}" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
