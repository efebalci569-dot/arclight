<UserControl x:Class="Arclight.Desktop.Views.DiscoverView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560" Margin="40,0,40,80">
            <Border Width="72" Height="72" CornerRadius="20" Background="{DynamicResource Brush.Accent.Soft}" HorizontalAlignment="Center">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE909;" FontSize="30" Foreground="{DynamicResource Brush.Accent.Text}" />
            </Border>
            <Border Background="{DynamicResource Brush.Bg.Hover}" CornerRadius="999" Padding="12,4" HorizontalAlignment="Center" Margin="0,20,0,0">
                <TextBlock Text="{DynamicResource Discover.PlannedForAFutureVersion}" FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}" />
            </Border>
            <TextBlock Text="{DynamicResource Discover.DiscoverIsOnItsWay}" Style="{StaticResource Text.Title}" TextAlignment="Center" Margin="0,14,0,0" />
            <TextBlock Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.Text.Secondary}" TextAlignment="Center" Margin="0,12,0,0"
                       Text="{DynamicResource Discover.DiscoverWillShowPopularAnd}" />
            <Button Style="{StaticResource Button.Secondary}" Content="{DynamicResource Discover.BrowseMyLibrary}" Command="{Binding OpenLibraryCommand}" HorizontalAlignment="Center" Padding="18,10" Margin="0,24,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
