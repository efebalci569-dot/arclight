<UserControl x:Class="Arclight.Desktop.Controls.TagEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Arclight.Desktop.Controls"
             x:Name="Root">
    <StackPanel>
        <ItemsControl ItemsSource="{Binding Tags, ElementName=Root}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource Brush.Accent.Soft}" CornerRadius="999" Padding="11,4,5,4" Margin="0,0,6,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding}" FontSize="13" Foreground="{DynamicResource Brush.Text.Primary}" VerticalAlignment="Center" />
                            <Button Style="{StaticResource Button.Icon}" Width="20" Height="20" FontSize="9" Margin="6,0,0,0"
                                    Content="&#xE711;" ToolTip="{DynamicResource Tags.RemoveTag}" Click="OnRemoveClick" CommandParameter="{Binding}"
                                    controls:Ui.CornerRadius="10" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Grid>
            <TextBox x:Name="Input" Tag="{DynamicResource Tags.AddATagAndPress}" KeyDown="OnInputKeyDown" TextChanged="OnInputTextChanged"
                     LostKeyboardFocus="OnInputLostFocus" MinHeight="36" Padding="12,6" />
            <Popup x:Name="SuggestionPopup" PlacementTarget="{Binding ElementName=Input}" Placement="Bottom" AllowsTransparency="True"
                   StaysOpen="False" PopupAnimation="Fade">
                <Border Margin="0,4,10,12" MinWidth="{Binding ActualWidth, ElementName=Input}" Background="{DynamicResource Brush.Bg.Elevated}"
                        BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1" CornerRadius="10" Padding="4"
                        Effect="{StaticResource Shadow.Popup}">
                    <ItemsControl x:Name="Suggestions">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Button.Ghost}" Content="{Binding}" HorizontalContentAlignment="Left"
                                        HorizontalAlignment="Stretch" Padding="10,7" Click="OnSuggestionClick" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </Popup>
        </Grid>
    </StackPanel>
</UserControl>
