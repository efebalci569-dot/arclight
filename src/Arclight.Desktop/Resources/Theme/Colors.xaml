<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Arclight palette. Every brush is referenced with DynamicResource so ThemeService can swap
        the accent color and the background set (Dark / OLED Black) at runtime.
    -->
    <Color x:Key="Color.Bg.App">#09090B</Color>
    <Color x:Key="Color.Bg.Secondary">#101014</Color>
    <Color x:Key="Color.Bg.Card">#17171D</Color>
    <Color x:Key="Color.Bg.Hover">#22222B</Color>
    <Color x:Key="Color.Bg.Elevated">#1A1A21</Color>
    <Color x:Key="Color.Text.Primary">#F5F5F7</Color>
    <Color x:Key="Color.Text.Secondary">#A1A1AA</Color>
    <Color x:Key="Color.Text.Muted">#71717A</Color>
    <Color x:Key="Color.Accent">#8B5CF6</Color>
    <Color x:Key="Color.Info">#38BDF8</Color>
    <Color x:Key="Color.Success">#34D399</Color>
    <Color x:Key="Color.Warning">#FBBF24</Color>
    <Color x:Key="Color.Danger">#F87171</Color>

    <SolidColorBrush x:Key="Brush.Bg.App" Color="#09090B" />
    <SolidColorBrush x:Key="Brush.Bg.Secondary" Color="#101014" />
    <SolidColorBrush x:Key="Brush.Bg.Card" Color="#17171D" />
    <SolidColorBrush x:Key="Brush.Bg.Hover" Color="#22222B" />
    <SolidColorBrush x:Key="Brush.Bg.Elevated" Color="#1A1A21" />
    <SolidColorBrush x:Key="Brush.Bg.Input" Color="#141419" />
    <SolidColorBrush x:Key="Brush.Bg.Overlay" Color="#B3050507" />

    <SolidColorBrush x:Key="Brush.Border.Subtle" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="Brush.Border.Default" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="Brush.Border.Strong" Color="#33FFFFFF" />

    <SolidColorBrush x:Key="Brush.Text.Primary" Color="#F5F5F7" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#A1A1AA" />
    <SolidColorBrush x:Key="Brush.Text.Muted" Color="#71717A" />
    <SolidColorBrush x:Key="Brush.Text.OnAccent" Color="#FFFFFF" />

    <SolidColorBrush x:Key="Brush.Accent" Color="#8B5CF6" />
    <SolidColorBrush x:Key="Brush.Accent.Hover" Color="#9D76F7" />
    <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="#7A4BE6" />
    <SolidColorBrush x:Key="Brush.Accent.Soft" Color="#268B5CF6" />
    <SolidColorBrush x:Key="Brush.Accent.Glow" Color="#598B5CF6" />
    <SolidColorBrush x:Key="Brush.Accent.Text" Color="#B79CFA" />

    <SolidColorBrush x:Key="Brush.Info" Color="#38BDF8" />
    <SolidColorBrush x:Key="Brush.Info.Soft" Color="#2638BDF8" />
    <SolidColorBrush x:Key="Brush.Success" Color="#34D399" />
    <SolidColorBrush x:Key="Brush.Success.Soft" Color="#2634D399" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#FBBF24" />
    <SolidColorBrush x:Key="Brush.Warning.Soft" Color="#26FBBF24" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#F87171" />
    <SolidColorBrush x:Key="Brush.Danger.Soft" Color="#26F87171" />

    <!-- Gradients used over artwork so text stays readable on any image. -->
    <LinearGradientBrush x:Key="Brush.Scrim.Bottom" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#0009090B" />
        <GradientStop Offset="0.55" Color="#9909090B" />
        <GradientStop Offset="1" Color="#F209090B" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.Scrim.Left" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#F209090B" />
        <GradientStop Offset="0.45" Color="#B309090B" />
        <GradientStop Offset="1" Color="#1A09090B" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.Scrim.Card" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.35" Color="#0009090B" />
        <GradientStop Offset="1" Color="#E609090B" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.Arc" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#8B5CF6" />
        <GradientStop Offset="1" Color="#38BDF8" />
    </LinearGradientBrush>

    <!-- Typography -->
    <FontFamily x:Key="Font.Display">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Text">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <CornerRadius x:Key="Radius.Small">6</CornerRadius>
    <CornerRadius x:Key="Radius.Medium">10</CornerRadius>
    <CornerRadius x:Key="Radius.Large">14</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">999</CornerRadius>
</ResourceDictionary>
