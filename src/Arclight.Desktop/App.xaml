<Application x:Class="Arclight.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Arclight.Desktop.Converters"
             xmlns:vm="clr-namespace:Arclight.Desktop.ViewModels"
             xmlns:dialogs="clr-namespace:Arclight.Desktop.ViewModels.Dialogs"
             xmlns:services="clr-namespace:Arclight.Desktop.Services"
             xmlns:views="clr-namespace:Arclight.Desktop.Views"
             xmlns:dviews="clr-namespace:Arclight.Desktop.Views.Dialogs"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Theme/Colors.xaml" />
                <ResourceDictionary Source="Resources/Theme/Converters.xaml" />
                <ResourceDictionary Source="Resources/Theme/Controls.xaml" />
                <ResourceDictionary Source="Views/Templates.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Pages -->
            <DataTemplate DataType="{x:Type vm:HomeViewModel}"><views:HomeView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:LibraryViewModel}"><views:LibraryView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:CollectionsViewModel}"><views:CollectionsView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:RecentlyPlayedViewModel}"><views:RecentlyPlayedView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:StatisticsViewModel}"><views:StatisticsView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:DiscoverViewModel}"><views:DiscoverView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:GameDetailViewModel}"><views:GameDetailView /></DataTemplate>

            <!-- Dialogs -->
            <DataTemplate DataType="{x:Type services:ConfirmDialogViewModel}"><dviews:ConfirmDialog /></DataTemplate>
            <DataTemplate DataType="{x:Type services:InfoDialogViewModel}"><dviews:InfoDialog /></DataTemplate>
            <DataTemplate DataType="{x:Type dialogs:GameEditorViewModel}"><dviews:GameEditorDialog /></DataTemplate>
            <DataTemplate DataType="{x:Type dialogs:ScanViewModel}"><dviews:ScanDialog /></DataTemplate>
            <DataTemplate DataType="{x:Type dialogs:CollectionEditorViewModel}"><dviews:CollectionEditorDialog /></DataTemplate>
            <DataTemplate DataType="{x:Type dialogs:GamePickerViewModel}"><dviews:GamePickerDialog /></DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
